   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split, GridSearchCV\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from xgboost import XGBClassifier\n",
    "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, roc_curve, auc, RocCurveDisplay\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns \n",
    "import shap\n",
    "\n",
    "# Load the dataset\n",
    "df=pd.read_csv('traffic_data.csv')\n",
    "\n",
    "# Identify the target column (assuming it's the last column)\n",
    "target_column = df.columns[-1]\n",
    "print(f\"\\nUsing '{target_column}' as the target column for prediction.\")\n",
    "\n",
    "# Preprocessing: Label Encoding for categorical features\n",
    "le=LabelEncoder()\n",
    "for column in df.columns:\n",
    "    if df[column].dtype=='object':\n",
    "        df[column]= le.fit_transform(df[column])\n",
    "\n",
    "# Separate features (X) and target (y)\n",
    "# X_original_features is kept to retain original column names for plotting feature importances later\n",
    "X_original_features = df.drop(target_column,axis=1) \n",
    "y=df[target_column]\n",
    "\n",
    "# Split data into training and testing sets (using original feature DataFrame for now)\n",
    "X_train_df, X_test_df, y_train, y_test = train_test_split(X_original_features, y, test_size=0.2, random_state=42)\n",
    "\n",
    "# Feature Scaling: Standardize features by removing the mean and scaling to unit variance\n",
    "# Scaler is fitted only on the training data to prevent data leakage from the test set.\n",
    "scaler = StandardScaler()\n",
    "X_train = scaler.fit_transform(X_train_df) # Fit and transform training data\n",
    "X_test = scaler.transform(X_test_df)     # Transform test data using the same scaler\n",
    "\n",
    "# Define a comprehensive function to train models, evaluate, and plot results\n",
    "def train_evaluate(model, X_train_data, X_test_data, y_train_data, y_test_data, model_name):\n",
    "    model.fit(X_train_data, y_train_data)\n",
    "    y_pred = model.predict(X_test_data)\n",
    "    acc_score = accuracy_score(y_test_data, y_pred)\n",
    "    \n",
    "    print(f\"\\n--- {model_name} ---\")\n",
    "    print(\"Classification Report:\")\n",
    "    # zero_division=0 handles cases where a class might not have any predicted samples, avoiding warnings/errors.\n",
    "    print(classification_report(y_test_data, y_pred, zero_division=0))\n",
    "    print(f\"Accuracy: {acc_score:.4f}\")\n",
    "    \n",
    "    roc_auc = None\n",
    "    # Check if the model has predict_proba method for ROC AUC calculation\n",
    "    if hasattr(model, 'predict_proba'):\n",
    "        y_pred_proba = model.predict_proba(X_test_data)[:, 1] # Probabilities for the positive class\n",
    "        fpr, tpr, _ = roc_curve(y_test_data, y_pred_proba)\n",
    "        roc_auc = auc(fpr, tpr)\n",
    "        print(f\"ROC AUC: {roc_auc:.4f}\")\n",
    "        \n",
    "        # Plot ROC Curve\n",
    "        RocCurveDisplay.from_estimator(model, X_test_data, y_test_data)\n",
    "        plt.title(f'{model_name} ROC Curve (AUC = {roc_auc:.2f})')\n",
    "        plt.show()\n",
    "    else:\n",
    "        print(\"ROC AUC not available as model does not support predict_proba.\")\n",
    "        \n",
    "    # Plot Confusion Matrix\n",
    "    cm = confusion_matrix(y_test_data, y_pred)\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')\n",
    "    plt.title(f'{model_name} Confusion Matrix')\n",
    "    plt.xlabel('Predicted Label')\n",
    "    plt.ylabel('True Label')\n",
    "    plt.show()\n",
    "    \n",
    "    # Plot Feature Importances (if available)\n",
    "    if hasattr(model, 'feature_importances_'):\n",
    "        feature_importance = model.feature_importances_\n",
    "        # Use original feature names for interpretability\n",
    "        feature_names_for_plot = X_original_features.columns \n",
    "        sorted_idx = np.argsort(feature_importance)\n",
    "        pos = np.arange(sorted_idx.shape[0]) + .5\n",
    "        plt.figure(figsize=(10, 6))\n",
    "        plt.barh(pos, feature_importance[sorted_idx], align='center')\n",
    "        plt.yticks(pos, feature_names_for_plot[sorted_idx])\n",
    "        plt.xlabel('Feature Importance Value')\n",
    "        plt.title(f'{model_name} Feature Importance')\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "    else:\n",
    "        print(f\"\\nFeature importances not available for {model_name}.\")\n",
    "        \n",
    "    return model, acc_score, roc_auc\n",
    "\n",
    "# Train and evaluate Decision Tree\n",
    "dt_model, dt_accuracy, dt_roc_auc = train_evaluate(DecisionTreeClassifier(random_state=42),X_train,X_test,y_train,y_test,\"Decision Tree Classifier\")\n",
    "\n",
    "# Train and evaluate Random Forest\n",
    "rf_model, rf_accuracy, rf_roc_auc = train_evaluate(RandomForestClassifier(n_estimators=100,random_state=42),X_train,X_test,y_train,y_test,\"Random Forest Classifier\")\n",
    "\n",
    "# Train and evaluate default XGBoost Classifier\n",
    "print(\"\\n--- Default XGBoost Classifier --- \")\n",
    "xgb_default_model, xgb_default_accuracy, xgb_default_roc_auc = train_evaluate(\n",
    "    XGBClassifier(random_state=42, use_label_encoder=False, eval_metric='logloss'), # use_label_encoder=False to avoid warnings, eval_metric for explicit objective\n",
    "    X_train, X_test, y_train, y_test, \n",
    "    \"Default XGBoost Classifier\"\n",
    ")\n",
    "\n",
    "# Hyperparameter Tuning for XGBoost using GridSearchCV\n",
    "print(\"\\n--- XGBoost Hyperparameter Tuning with GridSearchCV ---\")\n",
    "param_grid_xgb = {\n",
    "    'n_estimators': [50, 100],        # Number of boosting rounds\n",
    "    'max_depth': [3, 5],             # Maximum depth of a tree\n",
    "    'learning_rate': [0.1, 0.2]      # Step size shrinkage\n",
    "    # A reduced grid is used here for faster execution in limited environments.\n",
    "    # A more extensive grid might include 'subsample', 'colsample_bytree', etc.\n",
    "}\n",
    "\n",
    "grid_search_xgb = GridSearchCV(\n",
    "    estimator=XGBClassifier(random_state=42, use_label_encoder=False, eval_metric='logloss'),\n",
    "    param_grid=param_grid_xgb, \n",
    "    cv=2, # Using 2-fold CV for speed; 3 or 5 is more common for robustness\n",
    "    scoring='roc_auc', # Optimize for ROC AUC\n",
    "    n_jobs=-1, # Use all available cores\n",
    "    verbose=1  # Show progress\n",
    ")\n",
    "\n",
    "grid_search_xgb.fit(X_train, y_train)\n",
    "print(f\"\\nBest XGBoost parameters found (tuned for ROC AUC): {grid_search_xgb.best_params_}\")\n",
    "best_xgb_model = grid_search_xgb.best_estimator_\n",
    "\n",
    "# Train and evaluate the tuned XGBoost model\n",
    "tuned_xgb_model, tuned_xgb_accuracy, tuned_xgb_roc_auc = train_evaluate(\n",
    "    best_xgb_model, \n",
    "    X_train, X_test, y_train, y_test, \n",
    "    \"Tuned XGBoost Classifier\"\n",
    ")\n",
    "\n",
    "# --- Descriptive Conclusions Section ---\n",
    "print(\"\\n\\n--- Descriptive Conclusions ---\")\n",
    "print(\"\\n1. Model Performances\")\n",
    "print(f\"   - Decision Tree:     Accuracy = {dt_accuracy:.2%}, ROC AUC = {dt_roc_auc if dt_roc_auc is not None and not np.isnan(dt_roc_auc) else 'N/A'}\")\n",
    "print(f\"   - Random Forest:     Accuracy = {rf_accuracy:.2%}, ROC AUC = {rf_roc_auc if rf_roc_auc is not None and not np.isnan(rf_roc_auc) else 'N/A'}\")\n",
    "print(f\"   - Default XGBoost:   Accuracy = {xgb_default_accuracy:.2%}, ROC AUC = {xgb_default_roc_auc if xgb_default_roc_auc is not None and not np.isnan(xgb_default_roc_auc) else 'N/A'}\")\n",
    "print(f\"   - Tuned XGBoost:     Accuracy = {tuned_xgb_accuracy:.2%}, ROC AUC = {tuned_xgb_roc_auc if tuned_xgb_roc_auc is not None and not np.isnan(tuned_xgb_roc_auc) else 'N/A'}\")\n",
    "\n",
    "print(\"\\n2. Model Comparisons\")\n",
    "metrics = {\n",
    "    \"Decision Tree Classifier\": {'accuracy': dt_accuracy, 'roc_auc': dt_roc_auc},\n",
    "    \"Random Forest Classifier\": {'accuracy': rf_accuracy, 'roc_auc': rf_roc_auc},\n",
    "    \"Default XGBoost Classifier\": {'accuracy': xgb_default_accuracy, 'roc_auc': xgb_default_roc_auc},\n",
    "    \"Tuned XGBoost Classifier\": {'accuracy': tuned_xgb_accuracy, 'roc_auc': tuned_xgb_roc_auc}\n",
    "}\n",
    "best_model_name = None\n",
    "best_roc_auc = -1.0 \n",
    "best_accuracy_at_best_roc_auc = -1.0\n",
    "\n",
    "for name, scores in metrics.items():\n",
    "    current_roc_auc = scores.get('roc_auc')\n",
    "    current_accuracy = scores.get('accuracy')\n",
    "    # Check if current_roc_auc is valid (not None and not NaN)\n",
    "    if current_roc_auc is not None and not np.isnan(current_roc_auc):\n",
    "        if current_roc_auc > best_roc_auc:\n",
    "            best_roc_auc = current_roc_auc\n",
    "            best_accuracy_at_best_roc_auc = current_accuracy\n",
    "            best_model_name = name\n",
    "        elif current_roc_auc == best_roc_auc: # Tie in ROC AUC, check accuracy\n",
    "            if current_accuracy > best_accuracy_at_best_roc_auc:\n",
    "                best_accuracy_at_best_roc_auc = current_accuracy\n",
    "                best_model_name = name\n",
    "    # Fallback: if ROC AUC is not valid/available for this model, and we haven't found a best model yet based on ROC AUC\n",
    "    elif best_roc_auc == -1.0 and current_accuracy > best_accuracy_at_best_roc_auc: \n",
    "        best_accuracy_at_best_roc_auc = current_accuracy\n",
    "        best_model_name = name # Tentatively set best model based on accuracy\n",
    "\n",
    "if best_model_name:\n",
    "    best_model_metrics = metrics[best_model_name]\n",
    "    roc_auc_display = f\"{best_model_metrics['roc_auc']:.2f}\" if best_model_metrics['roc_auc'] is not None and not np.isnan(best_model_metrics['roc_auc']) else 'N/A'\n",
    "    print(f\"   - The best performing model overall (prioritizing ROC AUC, then accuracy) is {best_model_name} \\n     with ROC AUC: {roc_auc_display} and Accuracy: {best_model_metrics['accuracy']:.2%}.\")\n",
    "    if 'XGBoost' in best_model_name:\n",
    "        print(\"     XGBoost's gradient boosting mechanism often allows it to capture more complex non-linear relationships and feature interactions. \\n     Hyperparameter tuning (optimizing for ROC AUC in this case) further refines its performance for this specific dataset, making it more robust.\")\n",
    "else:\n",
    "    print(\"   - Could not definitively determine the best model. This might occur if all ROC AUC scores are N/A or invalid.\")\n",
    "\n",
    "print(\"\\n3. Key Findings from Feature Importances\")\n",
    "if hasattr(tuned_xgb_model, 'feature_importances_'):\n",
    "    xgb_most_important_feature_idx = tuned_xgb_model.feature_importances_.argmax()\n",
    "    xgb_most_important_feature = X_original_features.columns[xgb_most_important_feature_idx]\n",
    "    print(f\"   - The most important feature identified by the Tuned XGBoost model is '{xgb_most_important_feature}'.\")\n",
    "else:\n",
    "    print(\"   - Feature importances for the Tuned XGBoost model could not be directly extracted (this is unexpected for XGBoost).\")\n",
    "if hasattr(rf_model, 'feature_importances_'):\n",
    "    rf_most_important_feature_idx = rf_model.feature_importances_.argmax()\n",
    "    rf_most_important_feature = X_original_features.columns[rf_most_important_feature_idx]\n",
    "    print(f\"   - The most important feature identified by the Random Forest model is '{rf_most_important_feature}'.\")\n",
    "\n",
    "# --- SHAP Model Interpretability Section ---\n",
    "print(\"\\n\\n--- 4. Model Interpretability using SHAP ---\")\n",
    "shap.initjs() # Initialize JavaScript visualization for SHAP plots in Jupyter environment\n",
    "\n",
    "# Convert X_test (numpy array from scaling) back to a Pandas DataFrame for SHAP, using original column names\n",
    "X_test_df_for_shap = pd.DataFrame(X_test, columns=X_original_features.columns)\n",
    "\n",
    "print(\"\\nUsing Tuned XGBoost model for SHAP analysis.\")\n",
    "# Create TreeExplainer for tree-based models like XGBoost\n",
    "explainer = shap.TreeExplainer(tuned_xgb_model, X_test_df_for_shap)\n",
    "shap_values = explainer.shap_values(X_test_df_for_shap) # Calculate SHAP values\n",
    "\n",
    "print(\"\\nSHAP Summary Plot (Bar Type):\")\n",
    "print(\"This plot shows the average absolute SHAP value for each feature, indicating its overall importance.\")\n",
    "shap.summary_plot(shap_values, X_test_df_for_shap, plot_type=\"bar\", show=False)\n",
    "plt.title('SHAP Summary Plot (Bar) - Tuned XGBoost')\n", # Add a specific title
    "plt.show()\n",
    "\n",
    "print(\"\\nSHAP Summary Plot (Dot/Beeswarm Type - Default):\")\n",
    "print(\"This plot shows the SHAP values of every feature for every sample. Color indicates feature value (red=high, blue=low).\")\n",
    "shap.summary_plot(shap_values, X_test_df_for_shap, show=False)\n",
    "plt.title('SHAP Summary Plot (Beeswarm) - Tuned XGBoost')\n",
    "plt.show()\n",
    "\n",
    "# Dynamically select top features for dependence plots based on mean absolute SHAP values\n",
    "mean_abs_shap = np.abs(shap_values).mean(axis=0)\n",
    "sorted_feature_indices_shap = np.argsort(mean_abs_shap)[::-1]\n",
    "top_features_for_dependence = [X_original_features.columns[i] for i in sorted_feature_indices_shap[:min(3, len(X_original_features.columns))]]\n",
    "\n",
    "if top_features_for_dependence:\n",
    "   print(f\"\\nGenerating SHAP dependence plots for top features: {', '.join(top_features_for_dependence)}\")\n",
    "   for feature_name in top_features_for_dependence:\n",
    "       if feature_name in X_test_df_for_shap.columns:\n",
    "           print(f\"\\nSHAP Dependence Plot for '{feature_name}':\")\n",
    "           print(f\"Shows how the model's prediction for '{feature_name}' changes as its value changes, potentially revealing interaction effects.\")\n",
    "           shap.dependence_plot(feature_name, shap_values, X_test_df_for_shap, display_features=X_test_df_for_shap, show=False)\n",
    "           plt.title(f'SHAP Dependence Plot - {feature_name}')\n", # Add a specific title
    "           plt.show()\n",
    "       else:\n",
    "           print(f\"Could not generate dependence plot for {feature_name} as it's not in X_test_df_for_shap columns.\")\n",
    "else:\n",
    "    print(\"\\nCould not determine top features for SHAP dependence plots based on SHAP values.\")\n",
    "\n",
    "print(\"\\n\\n--- Overall Project Summary ---\")\n",
    "print(\"This project involved an end-to-end analysis of traffic accident prediction. Key steps included:\")\n",
    "print(\"- Data loading and initial exploration (target column identification). \")\n",
    "print(\"- Preprocessing: Label encoding for categorical features and feature scaling using StandardScaler (applied after train-test split to prevent data leakage). \")\n",
    "print(\"- Modeling: Evaluation of Decision Tree, Random Forest, and XGBoost classifiers. \")\n",
    "print(\"- Hyperparameter Tuning: GridSearchCV was used to optimize XGBoost, with ROC AUC as the primary scoring metric. \")\n",
    "print(\"- Evaluation: Models were assessed using classification reports, accuracy scores, confusion matrices, and ROC AUC scores with ROC curve plots. \")\n",
    "print(\"- Interpretability: SHAP (SHapley Additive exPlanations) was employed on the best performing model (Tuned XGBoost) to understand feature contributions via summary and dependence plots.\")\n",
    "print(\"The iterative process, from baseline models to a tuned, interpretable XGBoost model, aimed to build a robust and insightful predictive tool for traffic accidents.\")"
   ]
  }
 ],
